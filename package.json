{
  "name": "dsh-codesentry",
  "version": "1.0.0",
  "description": "dsh-codesentry —— 面向 DeepSeek Harness 的代码审计插件：分片多会话仓库审计、审计任务调度、漏洞提示词、SKILL.md 审计技能、发现与报告一键生成。",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src/**/*.js",
    "src/web/**",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.1.1-rc.2 <0.3.0"
  },
  "scripts": {
    "test": "node --test test/",
    "check": "node --check src/*.js"
  },
  "dsh": {
    "manifestVersion": 1,
    "engines": {
      "dsh": ">=0.1.1-rc.2 <0.3.0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.1-rc.2 <0.2.0 || >=0.2.0-rc.1 <0.2.1-0 || >=0.2.1-0 <0.3.0-0",
    "@deepseek-ai/dsh-commands": ">=0.1.1-rc.2 <0.2.0 || >=0.2.0-rc.1 <0.2.1-0 || >=0.2.1-0 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.1.1-rc.2 <0.2.0 || >=0.2.0-rc.1 <0.2.1-0 || >=0.2.1-0 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.1.1-rc.2 <0.2.0 || >=0.2.0-rc.1 <0.2.1-0 || >=0.2.1-0 <0.3.0-0",
    "react": "^18.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/414s857/dsh-codesentry.git"
  },
  "homepage": "https://github.com/414s857/dsh-codesentry#readme",
  "bugs": {
    "url": "https://github.com/414s857/dsh-codesentry/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "code-audit",
    "audit-skill",
    "security"
  ],
  "license": "MIT"
}
